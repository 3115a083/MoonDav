MOONDAV_LISTEN=:8765
MOONDAV_DATA_DIR=/data
MOONDAV_BASE_PATH=/dav/

# Credentials can be provided directly or with matching *_FILE variables.
MOONDAV_DAV_USER=moon
MOONDAV_DAV_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
MOONDAV_ADMIN_USER=admin
MOONDAV_ADMIN_PASSWORD=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

MOONDAV_MAX_UPLOAD_BYTES=8388608
MOONDAV_CONFLICT_POLICY=furthest

# none | calibre-web | booklore | kosync
MOONDAV_BACKEND=none
MOONDAV_BACKEND_URL=

# calibre-web
MOONDAV_BACKEND_TOKEN=

# BookLore / generic KOReader sync
MOONDAV_BACKEND_USER=
MOONDAV_BACKEND_PASSWORD=
MOONDAV_BACKEND_KEY=

MOONDAV_BOOK_MAP_FILE=/data/book-map.json

# Exact Moon+ <-> calibre-web KoboSpan translation. Requires a read-only EPUB library mount.
MOONDAV_EXACT_POSITIONS=false
MOONDAV_LIBRARY_ROOT=/books

# Optional notifications. Outages are only reported after this delay.
MOONDAV_NOTIFY_AFTER=10m
MOONDAV_NOTIFY_REPEAT=6h

# Telegram
MOONDAV_TELEGRAM_BOT_TOKEN=
MOONDAV_TELEGRAM_CHAT_ID=

# Generic HTTPS webhook
MOONDAV_WEBHOOK_URL=
MOONDAV_WEBHOOK_BEARER=

# SMTP, STARTTLS (587) or implicit TLS (465)
MOONDAV_SMTP_HOST=
MOONDAV_SMTP_PORT=587
MOONDAV_SMTP_TLS=starttls
MOONDAV_SMTP_USER=
MOONDAV_SMTP_PASSWORD=
MOONDAV_SMTP_FROM=
MOONDAV_SMTP_TO=
